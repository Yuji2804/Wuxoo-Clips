# ---- Wuxoo Clips settings. Copy this file to .env and fill it in. Never commit .env. ----
#
# On your own computer you need nothing here: start Wuxoo Clips, open it, and add your AI key under Settings, AI.
# This file is for servers, and for anyone who prefers to keep settings in a file.

# ================================================================ AI: bring your own key
# The easy way is the dashboard: Settings, AI. Whatever is saved there is used instead of these lines.
# Wuxoo Clips uses an AI model to pick the moments worth clipping and to write hooks, titles and captions.
# You choose the service and pay that service directly; Wuxoo Clips adds nothing on top.
# Without a key Wuxoo Clips still works: clips are then picked by loudness only, with no titles.
#
#   provider     where to get a key                          example model ids (check the provider's current list)
#   gemini       https://aistudio.google.com/apikey           gemini-2.5-flash
#   openai       https://platform.openai.com/api-keys         gpt-4o-mini
#   xai          https://console.x.ai                         grok-4            (Grok)
#   groq         https://console.groq.com/keys                llama-3.3-70b-versatile
#   openrouter   https://openrouter.ai/keys                   any model id listed there
#   anthropic    https://console.anthropic.com                a current Claude model id
#   ollama       no key: a model running on this machine      llama3.1          (ollama pull llama3.1)
#   custom       any service that speaks the OpenAI chat format: also set WUXOO_AI_BASE_URL
WUXOO_AI_PROVIDER=gemini
WUXOO_AI_MODELS=
WUXOO_AI_KEY=
# WUXOO_AI_KEY_FILE=/secrets/ai.txt        # instead of WUXOO_AI_KEY: a file that holds the key
# WUXOO_AI_BASE_URL=                       # only for "custom", e.g. http://127.0.0.1:1234/v1
# WUXOO_AI_MODELS takes several ids separated by commas. They are tried in order, so the second is a fallback.

# ================================================================ on a server (Docker)
# Your domain (DNS must already point at this server) and a database password you make up.
# WUXOO_DOMAIN=wuxoo.example.com
# POSTGRES_PASSWORD=change-me-to-a-long-random-string

# A server Wuxoo Clips has to itself: keep this line, and Wuxoo Clips fetches its own HTTPS certificate.
# A server that already runs a web server for other sites: leave it out and see deploy/nginx-wuxoo.conf.
# COMPOSE_PROFILES=own-https
# Behind Cloudflare's CDN: put the Cloudflare origin certificate in ./secrets as cloudflare-origin.crt and
# cloudflare-origin.key, and use the Caddyfile that serves it.
# WUXOO_CADDYFILE=Caddyfile.origin
# WUXOO_BIND_PORT=8420           # the port Wuxoo Clips listens on inside the server, if 8420 is taken
# Behind a Traefik that is already on the server, use this instead of the own-https line:
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.traefik.yml
# If the domain goes through Cloudflare's CDN (orange cloud), the visitor's real address comes in this header.
# It is only believed for connections that really come from Cloudflare.
# WUXOO_CLIENT_IP_HEADER=CF-Connecting-IP

# On a server shared with other apps: keep Wuxoo Clips inside its own share.
# WUXOO_MEM_LIMIT=2g             # most memory it may use (it is stopped, not the other apps, if it goes over)
# WUXOO_CPUS=1.5                 # most processor cores it may use
# WUXOO_CPU_SHARES=256           # its turn at the processor when the server is busy (1024 is normal)
# WUXOO_OOM_SCORE_ADJ=900        # if the whole server runs out of memory, Wuxoo Clips is stopped first
# WUXOO_DB_MEM_LIMIT=256m

# ================================================================ where things are kept (own computer)
# WUXOO_DATA=./data              # videos, clips, the database file and the speech model
# WUXOO_PORT=8420
# WUXOO_PUBLIC_URL=http://127.0.0.1:8420     # the address people open; set it to https://your-domain on a server
# DATABASE_URL=                    # empty: a SQLite file in the data folder. Or postgresql+psycopg://user:pass@host/db

# ================================================================ sign-in
# Off by default: Wuxoo Clips opens straight into the dashboard, which is right for your own computer.
# On a server other people can reach, turn accounts on, or anyone who finds the address can use it and your AI key.
# (docker-compose.yml turns them on by itself.)
# WUXOO_ACCOUNTS=1

# ================================================================ admins (only with accounts on)
# Admins are not set here. Every new account is a normal user. After you sign up, make yourself an admin:
#   python -m studio.admin grant you@example.com                 (also: revoke, list)
#   docker compose exec app python -m studio.admin grant you@example.com      (with Docker)
# The admin dashboard is then at /admin, and does not exist for anyone else.

# ================================================================ Google (optional)
# One "Web application" OAuth client, used for Sign in with Google and for connecting YouTube to post Shorts.
# Authorised redirect URIs:  https://YOUR-DOMAIN/auth/google/callback  and  https://YOUR-DOMAIN/oauth/youtube/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_FILE=/secrets/google_client.json

# Instagram and TikTok: the apps people's accounts connect through (Connect buttons in Settings, Connected apps).
# These can also be pasted in the dashboard by an admin: Settings, Connected apps, Set up. Redirect addresses to
# register:  https://YOUR-DOMAIN/oauth/instagram/callback  and  https://YOUR-DOMAIN/oauth/tiktok/callback
# WUXOO_IG_APP_ID=
# WUXOO_IG_APP_SECRET=
# WUXOO_TIKTOK_CLIENT_KEY=
# WUXOO_TIKTOK_CLIENT_SECRET=

# ================================================================ email (optional)
# Any SMTP service. Without it, password-reset and confirmation links are printed in the server's output instead,
# which is enough on your own computer.
# WUXOO_SMTP_HOST=
# WUXOO_SMTP_PORT=587
# WUXOO_SMTP_USER=
# WUXOO_SMTP_PASSWORD=
# WUXOO_SMTP_PASSWORD_FILE=/secrets/smtp.txt
# WUXOO_MAIL_FROM=Wuxoo Clips <hello@your-domain.com>
# WUXOO_VERIFY_EMAIL=1           # on a public site: people must confirm their email before clipping

# Shown on the privacy, terms and acceptable-use pages of a public site.
# WUXOO_CONTACT_EMAIL=
# WUXOO_LEGAL_NAME=
# WUXOO_LEGAL_COUNTRY=

# ================================================================ limits (all optional)
# How many videos run at once is decided by how busy the machine really is, every second. These only set the edges:
# WUXOO_JOB_WORKERS=8            # the most videos that may ever run at once (default: one per CPU core)
# WUXOO_BUSY_CPU=82              # no extra video or recording starts while the processor is above this percent
# WUXOO_MIN_FREE_RAM_GB=1.5      # ...or while less memory than this is free
# There are no limits unless you set one here: 0 (the default) means none. A server other people use may want some.
# WUXOO_MAX_LIVE=8               # live recordings at once, whole server (default: twice the CPU cores; load decides below it)
# WUXOO_MAX_LIVE_PER_USER=0      # streams one person records at once
# WUXOO_MAX_JOBS_PER_USER=5      # videos one person sends and has worked on at once
# WUXOO_MAX_UPLOAD_MB=0          # the largest video file someone may upload
# WUXOO_UPLOAD_PART_MB=40        # big files are sent in pieces of this size (Cloudflare refuses requests over 100 MB)
# WUXOO_MAX_VIDEO_HOURS=0        # longest video, or chosen part of one, that is processed
# WUXOO_MAX_LIVE_HOURS=0         # a live recording stops by itself after this long
# WUXOO_MAX_USER_GB=0            # disk space one account may use
# WUXOO_MAX_CREATORS=0           # creators one account may add
# WUXOO_FFMPEG_DIR=              # the folder that holds ffmpeg, if Wuxoo Clips cannot find it by itself
# WUXOO_CLIP_MINUTES=15          # a clip that takes longer than this to make is stopped, so it cannot hold the video up
# WUXOO_ALLOWED_SITES=youtube.com,youtu.be,twitch.tv,kick.com
# WUXOO_YT_TRANSCRIPT=1          # use YouTube's own transcript to find clips faster (0: always transcribe here)
# WUXOO_UPDATE_CHECK=1          # look on GitHub once a minute for a newer Wuxoo Clips (0: never)

# ================================================================ speech to text on a graphics card (optional)
# Speech is transcribed on this machine's processor by default. A second machine with an NVIDIA card can take
# over most of it: see deploy/gpu/docker-compose.yml, then set these on the main server.
# WUXOO_ASR_URL=http://10.0.0.2:9000
# WUXOO_ASR_TOKEN=a-long-random-string-shared-by-both-machines

# ================================================================ Earn: paid clipping campaigns (/earn)
# Campaigns are created at /admin/earn. With a YouTube Data API v3 key, every YouTube Short sent to a campaign is
# checked automatically (whose channel, when it was posted, the caption tag) and its views refresh every few hours.
# Without one, YouTube views are typed in by hand like Instagram and X. You can also paste the key in
# /admin/earn/settings instead.
# WUXOO_YOUTUBE_API_KEY=

# ================================================================ behind a Cloudflare Tunnel (cloudflared)
# Every visitor then reaches Wuxoo Clips from this machine itself. These two lines make sign-up and login limits
# count each real visitor, instead of everyone sharing one address (which would block sign-ups after a few people).
# WUXOO_TUNNEL=1
# WUXOO_CLIENT_IP_HEADER=CF-Connecting-IP

# ================================================================ the public Earn website (wuxooclips.com)
# On the website: Earn on, clip-making off for everyone but admins (people make clips with the free download).
# WUXOO_EARN_ONLY=1
# Where every "Download" button goes (default: the Google Drive folder with the zip and the setup guide).
# WUXOO_DOWNLOAD_URL=
# In the downloaded app: where its Earn button sends people (default https://wuxooclips.com).
# WUXOO_EARN_URL=https://wuxooclips.com
